# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL="https://api.absensikita.id"
VITE_SUPABASE_ANON_KEY="GANTI_DENGAN_ANON_KEY_ANDA"

# n8n Webhook Configuration
# Jika menggunakan server Node.js (Vite + Express), kosongkan saja agar menggunakan proxy /api.
# Jika di hosting static/cPanel tanpa Node.js, isi dengan URL webhook langsung (Full URL).
VITE_N8N_WA_OTP_URL="https://n8n.absensikita.id/webhook/waha-otp-login"
VITE_N8N_NOTIFY_URL="https://n8n.absensikita.id/webhook/waha-notify-expiration"

# WAHA API Configuration
# Jika tidak diisi, akan otomatis menggunakan default value dari kode program.
VITE_WAHA_URL="https://waha-j3kivpfbozbu.bagus.sumopod.my.id"
VITE_WAHA_API_KEY="7gc1xoO9YTzddFLB29emlk9zRx4STxEp"

# Midtrans Configuration
# Server key required for backend transaction creation
MIDTRANS_SERVER_KEY="MASUKAN_SERVER_KEY_ANDA_DISINI"
# Client key required for frontend Snap JS integration
VITE_MIDTRANS_CLIENT_KEY="MASUKAN_CLIENT_KEY_ANDA_DISINI"
# Set to 'true' for production API or 'false' for sandbox
MIDTRANS_IS_PRODUCTION="true"

# Telegram Bot Token (from BotFather)
TELEGRAM_BOT_TOKEN="MASUKAN_TELEGRAM_BOT_TOKEN_DISINI"

# SumoPod AI Configuration (Optional, jika ingin ganti Gemini)
SUMOPOD_API_KEY="MASUKAN_SUMOPOD_API_KEY_DISINI"
SUMOPOD_BASE_URL="https://ai.sumopod.com/v1"
SUMOPOD_MODEL="gemini/gemini-2.5-flash"

GEMINI_API_KEY=
